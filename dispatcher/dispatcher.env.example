# Copy to dispatcher.env (mode 600, never commit). Names only here; fill the values on the server.
# One block per project in config.json. The names are the ones config.json refers to (fire_url_env, fire_token_env, ...).

# Claude Code routine of the project's work run (Edit, Trigger, API, Generate token)
MY_PROJECT_FIRE_URL=
MY_PROJECT_FIRE_TOKEN=

# Read-only deploy key of the repository (path to the private key file on this server)
MY_PROJECT_DEPLOY_KEY_PATH=

# What the project's scripts/autopilot-check.sh needs (see pass_env in config.json)
MY_PROJECT_ITSAPLAN_URL=
MY_PROJECT_ITSAPLAN_API_KEY=
MY_PROJECT_GITHUB_TOKEN=

# Optional: webhook that receives a message when something fails. The body depends on webhook_format in config.json
# (discord, slack or auto; auto decides by host: discord.com, discordapp.com, hooks.slack.com)
DISPATCHER_ERROR_WEBHOOK_URL=

# Optional: push alarm of the watcher (alarm.channels "push" in config.json). An https URL, for example an ntfy topic.
# The URL is a secret: it is redacted in logs.
ALARM_PUSH_URL=

# Optional overrides
# FOREMAN_DISPATCHER_CONFIG=/etc/foreman/config.json
# Time zone and merge-window settings belong in the project's .foreman.json (context.timeZone, autopilot.batchHours).
# A FOREMAN_* variable set here reaches the check script only if the project lists it in pass_env,
# for example "pass_env": {"FOREMAN_TZ": "FOREMAN_TZ"}.
