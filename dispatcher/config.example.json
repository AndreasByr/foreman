{
  "workdir": "~/.local/share/foreman-dispatcher",
  "cooldown_minutes": 45,
  "max_tasks_cap": 3,
  "webhook_url_env": "DISPATCHER_ERROR_WEBHOOK_URL",
  "webhook_format": "auto",
  "foreman_version_source": "release",
  "foreman_repo": "AndreasByr/foreman",
  "update_notice": true,
  "heartbeat": {
    "limits_minutes": { "dispatcher": 30, "watcher": 45 },
    "default_limit_minutes": null
  },
  "alarm": {
    "channels": ["webhook"],
    "repeat_hours": 6,
    "push_url_env": "ALARM_PUSH_URL",
    "tracker": {
      "project": "my-project",
      "url_env": "MY_PROJECT_ITSAPLAN_URL",
      "key_env": "MY_PROJECT_ITSAPLAN_API_KEY"
    }
  },
  "projects": [
    {
      "name": "my-project",
      "enabled": true,
      "repo": "git@github.com:OWNER/REPO.git",
      "branch": "dev",
      "deploy_key_env": "MY_PROJECT_DEPLOY_KEY_PATH",
      "check": "scripts/autopilot-check.sh",
      "max_tasks": 3,
      "fire_url_env": "MY_PROJECT_FIRE_URL",
      "fire_token_env": "MY_PROJECT_FIRE_TOKEN",
      "pass_env": {
        "ITSAPLAN_URL": "MY_PROJECT_ITSAPLAN_URL",
        "ITSAPLAN_API_KEY": "MY_PROJECT_ITSAPLAN_API_KEY",
        "GITHUB_TOKEN": "MY_PROJECT_GITHUB_TOKEN"
      }
    },
    {
      "name": "my-local-claude-project",
      "enabled": false,
      "repo": "git@github.com:OWNER/OTHER-REPO.git",
      "branch": "dev",
      "deploy_key_env": "MY_OTHER_DEPLOY_KEY_PATH",
      "max_tasks": 1,
      "fire_command": "ssh my-server bash ~/fire-claude.sh"
    }
  ]
}
