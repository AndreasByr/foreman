[Unit]
Description=foreman watcher (judges the heartbeats and sends alarms)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust the path to where you cloned foreman. Install as a user unit: ~/.config/systemd/user/
WorkingDirectory=%h/foreman/dispatcher
EnvironmentFile=-%h/foreman/dispatcher/dispatcher.env
ExecStart=%h/foreman/dispatcher/watch.sh
TimeoutStartSec=5min
Nice=10
